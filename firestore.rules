rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // licenses collection: only the authenticated admin (by email) may
    // read or write directly from a browser. The TTS app itself NEVER
    // touches Firestore from the client — it goes through the app's own
    // backend, which uses the Firebase Admin SDK and always bypasses
    // these rules entirely. So this only needs to protect the admin panel.
    match /licenses/{licenseId} {
      allow read, write: if request.auth != null
                          && request.auth.token.email == "arshadlaidbeer@gmail.com";
    }

    // studentCodes collection: same admin-only access from the browser
    // (the GitHub Pusher tool's own backend uses the Admin SDK server-side,
    // which always bypasses these rules — this only protects the admin panel).
    match /studentCodes/{code} {
      allow read, write: if request.auth != null
                          && request.auth.token.email == "arshadlaidbeer@gmail.com";
    }

    // Everything else: denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
